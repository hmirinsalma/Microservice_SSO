@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Réinitialiser le mot de passe";
}

<div class="onee-card">
    <div class="onee-card-header">
        <div class="onee-logo">
            <i class="fas fa-lock-open"></i>
        </div>
        <h1 class="onee-title">Nouveau mot de passe</h1>
        <p class="onee-subtitle">Créez un mot de passe sécurisé pour votre compte</p>
    </div>

    <!-- Message de succès -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="onee-alert onee-alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@Model.SuccessMessage</span>
        </div>

        <div class="mt-4">
            <a href="/Login" class="onee-btn onee-btn-primary">
                <i class="fas fa-sign-in-alt"></i>
                Se connecter maintenant
            </a>
        </div>
    }
    else if (Model.IsTokenInvalid)
    {
        <!-- Token invalide ou expiré -->
        <div class="onee-alert onee-alert-error">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@Model.ErrorMessage</span>
        </div>

        <div class="mt-4">
            <a href="/ForgotPassword" class="onee-btn onee-btn-primary">
                <i class="fas fa-redo"></i>
                Faire une nouvelle demande
            </a>
        </div>

        <div class="mt-3">
            <a href="/Login" class="onee-btn onee-btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Retour à la connexion
            </a>
        </div>
    }
    else
    {
        <!-- Message d'erreur -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="onee-alert onee-alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <!-- Instructions -->
        <div class="mb-4">
            <p class="onee-text-muted" style="font-size: 0.9rem;">
                Réinitialisation pour : <strong>@Model.Email</strong>
            </p>
            <div class="onee-alert onee-alert-info mt-3">
                <i class="fas fa-info-circle"></i>
                <div style="font-size: 0.85rem; line-height: 1.5;">
                    <strong>Votre mot de passe doit contenir :</strong>
                    <ul style="margin: 0.5rem 0 0 1.5rem; padding: 0;">
                        <li>Au moins 8 caractères</li>
                        <li>Une lettre majuscule (A-Z)</li>
                        <li>Une lettre minuscule (a-z)</li>
                        <li>Un chiffre (0-9)</li>
                        <li>Un caractère spécial (@@$!%*?&)</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Formulaire -->
        <form method="post" id="resetPasswordForm">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <!-- Nouveau mot de passe -->
            <div class="onee-form-group">
                <label asp-for="NewPassword" class="onee-label">Nouveau mot de passe</label>
                <div class="onee-input-group">
                    <input asp-for="NewPassword" 
                           type="password" 
                           id="newPassword" 
                           class="onee-input" 
                           placeholder="••••••••"
                           autocomplete="new-password"
                           required />
                    <span class="onee-input-icon" onclick="togglePassword('newPassword')">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="NewPassword" class="onee-error-message"></span>
            </div>

            <!-- Confirmation mot de passe -->
            <div class="onee-form-group">
                <label asp-for="ConfirmPassword" class="onee-label">Confirmer le mot de passe</label>
                <div class="onee-input-group">
                    <input asp-for="ConfirmPassword" 
                           type="password" 
                           id="confirmPassword" 
                           class="onee-input" 
                           placeholder="••••••••"
                           autocomplete="new-password"
                           required />
                    <span class="onee-input-icon" onclick="togglePassword('confirmPassword')">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="onee-error-message"></span>
            </div>

            <!-- Indicateur de force du mot de passe -->
            <div id="passwordStrength" class="mb-3" style="display: none;">
                <div style="font-size: 0.85rem; margin-bottom: 0.5rem;">
                    Force du mot de passe : <span id="strengthText" style="font-weight: 600;"></span>
                </div>
                <div style="height: 4px; background: #e5e7eb; border-radius: 2px; overflow: hidden;">
                    <div id="strengthBar" style="height: 100%; width: 0%; transition: all 0.3s;"></div>
                </div>
            </div>

            <button type="submit" class="onee-btn onee-btn-primary" id="submitButton">
                <i class="fas fa-check"></i>
                Réinitialiser le mot de passe
            </button>
        </form>

        <div class="onee-divider mt-4">
            <span>ou</span>
        </div>

        <div class="mt-3">
            <a href="/Login" class="onee-btn onee-btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Retour à la connexion
            </a>
        </div>
    }

    <!-- Footer -->
    <div class="onee-footer">
        <p class="onee-footer-text">
            <i class="fas fa-shield-alt" style="color: var(--onee-success);"></i>
            Processus sécurisé
        </p>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        const newPasswordInput = document.getElementById('newPassword');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const strengthDiv = document.getElementById('passwordStrength');
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');

        if (newPasswordInput) {
            newPasswordInput.addEventListener('input', function() {
                const password = this.value;
                
                if (password.length === 0) {
                    strengthDiv.style.display = 'none';
                    return;
                }

                strengthDiv.style.display = 'block';

                // Calculer la force
                let strength = 0;
                if (password.length >= 8) strength++;
                if (/[a-z]/.test(password)) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[0-9]/.test(password)) strength++;
                if (/[@@$!%*?&]/.test(password)) strength++;

                // Afficher la force
                const colors = ['#ef4444', '#f59e0b', '#f59e0b', '#10b981', '#10b981'];
                const texts = ['Très faible', 'Faible', 'Moyen', 'Fort', 'Très fort'];
                const widths = ['20%', '40%', '60%', '80%', '100%'];

                strengthBar.style.width = widths[strength - 1] || '0%';
                strengthBar.style.background = colors[strength - 1] || '#ef4444';
                strengthText.textContent = texts[strength - 1] || 'Très faible';
                strengthText.style.color = colors[strength - 1] || '#ef4444';
            });
        }

        const form = document.getElementById('resetPasswordForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                const button = document.getElementById('submitButton');
                if (button) {
                    showLoading(button);
                }
            });
        }
    </script>
}
