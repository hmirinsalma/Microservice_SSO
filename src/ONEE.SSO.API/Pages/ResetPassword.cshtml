@page
@model ONEE.SSO.API.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Réinitialisation du mot de passe";
}

<div class="onee-card">
    <!-- Header -->
    <div class="onee-card-header">
        <div class="onee-logo">
            <i class="fas fa-lock-open"></i>
        </div>
        <h1 class="onee-title">Réinitialiser le mot de passe</h1>
        <p class="onee-subtitle">Entrez votre nouveau mot de passe</p>
    </div>

    <!-- Message de succès -->
    @if (Model.ShowSuccessMessage)
    {
        <div class="onee-alert onee-alert-success" role="alert">
            <i class="fas fa-check-circle"></i>
            <span>@Model.SuccessMessage</span>
        </div>
        
        <div class="mt-3">
            <a href="/Login" class="onee-btn onee-btn-primary">
                <i class="fas fa-sign-in-alt"></i>
                Se connecter
            </a>
        </div>
    }
    else
    {
        <!-- Message d'erreur -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="onee-alert onee-alert-error" role="alert">
                <i class="fas fa-exclamation-circle"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <!-- Formulaire -->
        <form method="post" id="resetPasswordForm">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <!-- Nouveau mot de passe -->
            <div class="onee-form-group">
                <label asp-for="NewPassword" class="onee-label">Nouveau mot de passe</label>
                <div class="onee-input-group">
                    <input asp-for="NewPassword" 
                           type="password" 
                           id="newPassword" 
                           class="onee-input" 
                           placeholder="••••••••"
                           required />
                    <span class="onee-input-icon" onclick="togglePassword('newPassword')">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="NewPassword" class="onee-error-message"></span>
                <small class="text-muted">
                    Le mot de passe doit contenir au moins 8 caractères, une majuscule, une minuscule, un chiffre et un caractère spécial.
                </small>
            </div>

            <!-- Confirmer le mot de passe -->
            <div class="onee-form-group">
                <label asp-for="ConfirmPassword" class="onee-label">Confirmer le mot de passe</label>
                <div class="onee-input-group">
                    <input asp-for="ConfirmPassword" 
                           type="password" 
                           id="confirmPassword" 
                           class="onee-input" 
                           placeholder="••••••••"
                           required />
                    <span class="onee-input-icon" onclick="togglePassword('confirmPassword')">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="onee-error-message"></span>
            </div>

            <!-- Bouton de soumission -->
            <button type="submit" class="onee-btn onee-btn-primary" id="submitButton">
                <i class="fas fa-check"></i>
                Réinitialiser le mot de passe
            </button>
        </form>

        <!-- Divider -->
        <div class="onee-divider mt-4">
            <span>ou</span>
        </div>

        <!-- Retour à la connexion -->
        <div class="mt-3">
            <a href="/Login" class="onee-btn onee-btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Retour à la connexion
            </a>
        </div>
    }

    <!-- Footer -->
    <div class="onee-footer">
        <p class="onee-footer-text">
            <i class="fas fa-lock" style="color: var(--onee-success);"></i>
            Connexion sécurisée
        </p>
        <p class="onee-footer-text mt-2">
            © 2026 ONEE - Office National de l'Électricité et de l'Eau Potable
        </p>
    </div>
</div>

@section Scripts {
    <script>
        // Gérer la soumission du formulaire
        document.getElementById('resetPasswordForm')?.addEventListener('submit', function(e) {
            const button = document.getElementById('submitButton');
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            if (newPassword !== confirmPassword) {
                e.preventDefault();
                alert('Les mots de passe ne correspondent pas.');
                return false;
            }
            
            // Afficher le loading
            showLoading(button);
        });

        // Auto-focus sur le champ nouveau mot de passe
        document.addEventListener('DOMContentLoaded', function() {
            const newPasswordInput = document.getElementById('newPassword');
            if (newPasswordInput) {
                newPasswordInput.focus();
            }
        });
    </script>
}
