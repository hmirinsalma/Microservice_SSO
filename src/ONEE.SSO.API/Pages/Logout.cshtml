@page
@model LogoutModel
@{
    ViewData["Title"] = "Déconnexion";
}

<div class="onee-card">
    <div class="onee-card-header">
        <div class="onee-logo">
            <i class="fas fa-sign-out-alt"></i>
        </div>
        <h1 class="onee-title">Déconnexion réussie</h1>
        <p class="onee-subtitle">Vous avez été déconnecté du SSO ONEE</p>
    </div>

    <div class="onee-alert onee-alert-info">
        <i class="fas fa-info-circle"></i>
        <span>Votre session a été terminée avec succès</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.UserEmail))
    {
        <div class="mt-3 mb-4">
            <p class="onee-text-center onee-text-muted">
                <i class="fas fa-user"></i>
                Utilisateur déconnecté : <strong>@Model.UserEmail</strong>
            </p>
        </div>
    }

    <div class="mt-4">
        <a href="/Login" class="onee-btn onee-btn-primary">
            <i class="fas fa-sign-in-alt"></i>
            Se reconnecter
        </a>

        <div class="mt-3">
            <a href="/" class="onee-btn onee-btn-secondary">
                <i class="fas fa-home"></i>
                Retour à l'accueil
            </a>
        </div>
    </div>

    <div class="onee-footer">
        <p class="onee-footer-text">
            <i class="fas fa-shield-alt" style="color: var(--onee-success);"></i>
            Merci d'avoir utilisé ONEE SSO
        </p>
        <p class="onee-footer-text mt-2">
            © 2026 ONEE - Office National de l'Électricité et de l'Eau Potable
        </p>
    </div>
</div>
