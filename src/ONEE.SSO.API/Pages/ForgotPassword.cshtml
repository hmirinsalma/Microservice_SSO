@page
@model ONEE.SSO.API.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<div class="onee-card">
    <!-- Header -->
    <div class="onee-card-header">
        <div class="onee-logo">
            <i class="fas fa-key"></i>
        </div>
        <h1 class="onee-title">Mot de passe oublié</h1>
        <p class="onee-subtitle">Entrez votre adresse email pour recevoir un lien de réinitialisation</p>
    </div>

    <!-- Message de succès -->
    @if (Model.ShowSuccessMessage)
    {
        <div class="onee-alert onee-alert-success" role="alert">
            <i class="fas fa-check-circle"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <!-- Message d'erreur -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="onee-alert onee-alert-error" role="alert">
            <i class="fas fa-exclamation-circle"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (!Model.ShowSuccessMessage)
    {
        <!-- Formulaire -->
        <form method="post" id="forgotPasswordForm">
            <!-- Email -->
            <div class="onee-form-group">
                <label asp-for="Email" class="onee-label">Adresse Email</label>
                <input asp-for="Email" 
                       type="email" 
                       class="onee-input" 
                       placeholder="votre@email.ma"
                       autocomplete="email"
                       required />
                <span asp-validation-for="Email" class="onee-error-message"></span>
            </div>

            <!-- Bouton de soumission -->
            <button type="submit" class="onee-btn onee-btn-primary" id="submitButton">
                <i class="fas fa-paper-plane"></i>
                Envoyer le lien de réinitialisation
            </button>
        </form>
    }

    <!-- Divider -->
    <div class="onee-divider mt-4">
        <span>ou</span>
    </div>

    <!-- Retour à la connexion -->
    <div class="mt-3">
        <a href="/Login" class="onee-btn onee-btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Retour à la connexion
        </a>
    </div>

    <!-- Footer -->
    <div class="onee-footer">
        <p class="onee-footer-text">
            <i class="fas fa-lock" style="color: var(--onee-success);"></i>
            Connexion sécurisée
        </p>
        <p class="onee-footer-text mt-2">
            © 2026 ONEE - Office National de l'Électricité et de l'Eau Potable
        </p>
    </div>
</div>

@section Scripts {
    <script>
        // Gérer la soumission du formulaire
        document.getElementById('forgotPasswordForm')?.addEventListener('submit', function(e) {
            const button = document.getElementById('submitButton');
            
            // Afficher le loading
            showLoading(button);
        });

        // Auto-focus sur le champ email
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.querySelector('input[type="email"]');
            if (emailInput) {
                emailInput.focus();
            }
        });
    </script>
}
