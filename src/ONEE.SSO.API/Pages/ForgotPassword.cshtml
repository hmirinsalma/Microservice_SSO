@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<div class="onee-card">
    <div class="onee-card-header">
        <div class="onee-logo">
            <i class="fas fa-key"></i>
        </div>
        <h1 class="onee-title">Mot de passe oublié ?</h1>
        <p class="onee-subtitle">Réinitialisez votre mot de passe en toute sécurité</p>
    </div>

    <!-- Message de succès -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="onee-alert onee-alert-success" data-auto-hide="false">
            <i class="fas fa-check-circle"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <!-- Message d'erreur -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="onee-alert onee-alert-error">
            <i class="fas fa-exclamation-circle"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <!-- Instructions -->
        <div class="mb-4">
            <p class="onee-text-muted" style="font-size: 0.95rem; line-height: 1.6;">
                Saisissez l'adresse email associée à votre compte. Nous vous enverrons un lien de réinitialisation de mot de passe.
            </p>
        </div>

        <!-- Formulaire -->
        <form method="post" id="forgotPasswordForm">
            <div class="onee-form-group">
                <label asp-for="Email" class="onee-label">Adresse Email</label>
                <input asp-for="Email" 
                       type="email" 
                       class="onee-input" 
                       placeholder="votre@email.ma"
                       autocomplete="email"
                       required />
                <span asp-validation-for="Email" class="onee-error-message"></span>
            </div>

            <button type="submit" class="onee-btn onee-btn-primary" id="submitButton">
                <i class="fas fa-paper-plane"></i>
                Envoyer le lien de réinitialisation
            </button>
        </form>

        <div class="onee-divider mt-4">
            <span>ou</span>
        </div>
    }

    <!-- Retour à la connexion -->
    <div class="mt-3">
        <a href="/Login" class="onee-btn onee-btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Retour à la connexion
        </a>
    </div>

    <!-- Footer -->
    <div class="onee-footer">
        <p class="onee-footer-text">
            <i class="fas fa-shield-alt" style="color: var(--onee-success);"></i>
            Processus sécurisé de réinitialisation
        </p>
        <p class="onee-footer-text mt-2">
            Le lien de réinitialisation expire après 1 heure
        </p>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('forgotPasswordForm')?.addEventListener('submit', function(e) {
            const button = document.getElementById('submitButton');
            if (button) {
                showLoading(button);
            }
        });

        // Auto-focus sur le champ email
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.querySelector('input[type="email"]');
            if (emailInput) {
                emailInput.focus();
            }
        });
    </script>
}
