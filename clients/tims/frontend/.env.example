# Configuration SSO TIMS - Exemple
# Copier ce fichier en .env.local et ajuster les valeurs

# SSO Configuration
VITE_SSO_AUTHORITY=http://localhost:5205
VITE_SSO_CLIENT_ID=tims-app
VITE_SSO_CLIENT_SECRET=secret-tims-2024
VITE_SSO_REDIRECT_URI=http://localhost:5173/callback
VITE_SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
VITE_SSO_SILENT_REDIRECT_URI=http://localhost:5173/silent-renew.html

# API Backend
VITE_API_BASE_URL=http://localhost:5115/api

# Scopes SSO
VITE_SSO_SCOPES=openid profile email roles offline_access tims tims_user_id tims_service_id tims_team_id

# Mode de développement
VITE_DEV_MODE=true
